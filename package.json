{
  "name": "apollo-client",
  "version": "0.1.6",
  "description": "Compact Electron desktop client for the Apollo music server.",
  "main": "main.js",
  "scripts": {
    "preinstall": "node scripts/check-engines.js",
    "start": "electron .",
    "build:app": "node scripts/build-app.js && node scripts/write-runtime-manifest.js",
    "prepare:package": "node -e \"const fs=require('node:fs');fs.rmSync('native-bin',{recursive:true,force:true});fs.mkdirSync('native-bin',{recursive:true})\"",
    "check:runtime": "node scripts/check-electron-runtime.js",
    "check:resources": "node scripts/check-resource-budget.js",
    "check:bundle": "node scripts/check-bundle-budget.js",
    "check:package": "node scripts/check-package-budget.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:ui": "electron --no-sandbox scripts/electron-ui-smoke.js",
    "audit:deps": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "verify": "npm run check:runtime && npm run check:resources && npm run check:syntax && npm test && npm run build:app && npm run check:bundle && npm run audit:deps",
    "pack:linux:ci": "npm run build:app && npm run prepare:package && electron-builder --dir --linux --publish never",
    "pack:win:ci": "npm run build:app && npm run prepare:package && electron-builder --win nsis --publish never",
    "build:discord-social-helper": "scripts\\build-discord-social-helper.cmd",
    "build:win": "npm run build:app && npm run prepare:package && electron-builder --win nsis",
    "build:win:portable": "npm run build:app && npm run prepare:package && electron-builder --dir --win --publish never && npm run check:package && node scripts/build-windows-portable.js",
    "build:win:social": "npm run build:app && npm run prepare:package && npm run build:discord-social-helper && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "keywords": [
    "apollo",
    "electron",
    "music-client"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.apollo.client",
    "productName": "Apollo Client",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "afterPack": "scripts/prune-electron-runtime.js",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist-app",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "native-bin",
        "to": "native-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "artifactName": "Apollo-Client-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.2"
  }
}
